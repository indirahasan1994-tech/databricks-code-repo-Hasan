flowchart LR
 subgraph SRC["SOURCE SYSTEM"]
        branchfile["branch"]
        customersfile["customer"]
        accountsfile["accounts"]
        employeefile["employees"]
        paymentfile["payment"]
        transactionfile["transaction"]
        creditcardfile["creditcard"]
        loanfile["loans"]
  end
 subgraph STAGING["STAGING LAYER"]
        branch["branch"]
        customers["customer"]
        accounts["accounts"]
        employee["employees"]
        payment["payment"]
        transaction["transaction"]
        creditcard["creditcard"]
        loan["loans"]
  end
 subgraph DSA["DSA LAYER"]
        branchtable["stg_branch"]
        customerstable["stg_customer"]
        accountstable["stg_accounts"]
        employeetable["stg_employees"]
        paymenttable["stg_payment"]
        transactiontable["stg_transaction"]
        creditcardtable["stg_creditcard"]
        loantable["stg_loans"]
  end      
  subgraph ODS["ODS STAGING AREA"]
        branchodstable["ods_branch"]
        customersodstable["ods_customer"]
        accountsodstable["ods_accounts"]
        employeeodstable["ods_employees"]
        paymentodstable["ods_payment"]
        transactionodstable["ods_transaction"]
        creditcardodstable["ods_creditcard"]
        loanodstable["ods_loans"]       
  end
   subgraph MARTS["Data Marts"]
        subgraph TRANS_MART["trans_mart"]
            fact_transactions[("fact_transactions")]
        end    
        subgraph PAYMENT_MART["pay_mart"]
            pay_transactions[("payment_transactions")]
        end 
        subgraph TRANS_MART["trans_mart"]
            fact_transactions[("fact_transactions")]
            agg_branch_trans_summary[("agg_branch_trans_summary")]
        end    
        subgraph CREDIT_MART["credit_mart"]
            credit_transactions[("creditcard_transactions")]
        end 
        subgraph LOANS_MART["loans_mart"]
            fact_high_value_loans[("fact_high_value_loans")]
        end 
   end
   subgraph EDW Layer["Enterprise DataWarehouse  - edwh"]
        subgraph DIMENSIONS["Dimensions"]
            dim_branch[("dim_branch")]  
            dim_employees[("dim_employees")]  
            dim_customer[("dim_customer")]  
            dim_loans[("dim_loans")]   
        end    
        subgraph FACTS["Facts & Aggregates"]
            fact_loans[("fact_loans")]
            fact_loan_summary[("fact_loan_summary")]
        end          
   end

